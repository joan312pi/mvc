@{
    Layout = "_Layout";
}


<form asp-action="RequestFormSubmit" method="post">
    <input type="text" name="Email" placeholder="Enter your email" />
    <input type="password" name="Password" placeholder="Enter your password" />

    <input type="submit" value="Submit" />
</form>

<form asp-action="RequestFromForm" method="post">
    <input type="text" name="Email" placeholder="Enter your email" />
    <input type="password" name="Password" placeholder="Enter your password" />

    <input type="submit" value="Submit" />
</form>

<form asp-action="RequestFromModel" method="post">
    <input type="text" name="Email" placeholder="Enter your email" />
    <input type="password" name="Password" placeholder="Enter your password" />

    <input type="submit" value="Submit" />
</form>